{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gusto Embedded Payroll BankAccounts Flows API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Flows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate flow link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gusto.com/v1/company/flows"
          },
          "docs": "Returns a flow link that expires in 1 hour."
        }
      ]
    }
  ],
  "bundled": true
}